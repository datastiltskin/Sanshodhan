284179688, 229.53338623046875, 423.3028564453125, 246.56338500976562]}, {"spans": [{"size": 13.0, "flags": 4, "bidi": 0, "char_flags": 16, "font": "BookmanOldStyle", "color": 2301728, "alpha": 255, "ascender": 0.9919999837875366, "descender": -0.3179999887943268, "text": "extremely difficult task for any ruler to accomplish in ", "origin": [82.013916015625, 258.952392578125], "bbox": [82.013916015625, 246.056396484375, 423.28985595703125, 263.0863952636719]}], "wmode": 0, "dir": [1.0, 0.0], "bbox": [82.013916015625, 246.056396484375, 423.28985595703125, 263.0863952636719]}, {"spans": [{"size": 13.0, "flags": 4, "bidi": 0, "char_flags": 16, "font": "BookmanOldStyle", "color": 2301728, "alpha": 255, "ascender": 0.9919999837875366, "descender": -0.3179999887943268, "text": "the Middle Ages. Quite in contrast to their predecessors, ", "origin": [82.013916015625, 275.47540283203125], "bbox": [82.013916015625, 262.57940673828125, 423.081787109375, 279.6094055175781]}], "wmode": 0, "dir": [1.0, 0.0], "bbox": [82.013916015625, 262.57940673828125, 423.081787109375, 279.6094055175781]}, {"spans": [{"size": 13.0, "flags": 4, "bidi": 0, "char_flags": 16, "font": "BookmanOldStyle", "color": 2301728, "alpha": 255, "ascender": 0.9919999837875366, "descender": -0.3179999887943268, "text": "the Mughals created an empire and accomplished what ", "origin": [82.013916015625, 291.9984130859375], "bbox": [82.013916015625, 279.1024169921875, 423.1339111328125, 296.1324157714844]}], "wmode": 0, "dir": [1.0, 0.0], "bbox": [82.013916015625, 279.1024169921875, 423.1339111328125, 296.1324157714844]}, {"spans": [{"size": 13.0, "flags": 4, "bidi": 0, "char_flags": 16, "font": "BookmanOldStyle", "color": 2301728, "alpha": 255, "ascender": 0.9919999837875366, "descender": -0.3179999887943268, "text": "had hitherto seemed possible for only short periods ", "origin": [82.013916015625, 308.52142333984375], "bbox": [82.013916015625, 295.62542724609375, 423.28985595703125, 312.6554260253906]}], "wmode": 0, "dir": [1.0, 0.0], "bbox": [82.013916015625, 295.62542724609375, 423.28985595703125, 312.6554260253906]}, {"spans": [{"size": 13.0, "flags": 4, "bidi": 0, "char_flags": 16, "font": "BookmanOldStyle", "color": 2301728, "alpha": 255, "ascender": 0.9919999837875366, "descender": -0.3179999887943268, "text": "of time. From the latter half of the sixteenth century, ", "origin": [82.013916015625, 325.04443359375], "bbox": [82.013916015625, 312.1484375, 423.2769775390625, 329.1784362792969]}], "wmode": 0, "dir": [1.0, 0.0], "bbox": [82.013916015625, 312.1484375, 423.2769775390625, 329.1784362792969]}, {"spans": [{"size": 13.0, "flags": 4, "bidi": 0, "char_flags": 16, "font": "BookmanOldStyle", "color": 2301728, "alpha": 255, "ascender": 0.9919999837875366, "descender": -0.3179999887943268, "text": "they expanded their kingdom from Agra and Delhi, ", "origin": [82.013916015625, 341.56744384765625], "bbox": [82.013916015625, 328.67144775390625, 423.302978515625, 345.7014465332031]}], "wmode": 0, "dir": [1.0, 0.0], "bbox": [82.013916015625, 328.67144775390625, 423.302978515625, 345.7014465332031]}, {"spans": [{"size": 13.0, "flags": 4, "bidi": 0, "char_flags": 16, "font": "BookmanOldStyle", "color": 2301728, "alpha": 255, "ascender": 0.9919999837875366, "descender": -0.3179999887943268, "text": "until in the seventeenth century they controlled nearly ", "origin": [82.013916015625, 358.0904541015625], "bbox": [82.013916015625, 345.1944580078125, 423.2508239746094, 362.2244567871094]}], "wmode": 0, "dir": [1.0, 0.0], "bbox": [82.013916015625, 345.1944580078125, 423.2508239746094, 362.2244567871094]}, {"spans": [{"size": 13.0, "flags": 4, "bidi": 0, "char_flags": 16, "font": "BookmanOldStyle", "color": 2301728, "alpha": 255, "ascender": 0.9919999837875366, "descender": -0.3179999887943268, "text": "all of the subcontinent. They imposed structures of ", "origin": [82.013916015625, 374.61346435546875], "bbox": [82.013916015625, 361.71746826171875, 423.2769775390625, 378.7474670410156]}], "wmode": 0, "dir": [1.0, 0.0], "bbox": [82.013916015625, 361.71746826171875, 423.2769775390625, 378.7474670410156]}, {"spans": [{"size": 13.0, "flags": 4, "bidi": 0, "char_flags": 16, "font": "BookmanOldStyle", "color": 2301728, "alpha": 255, "ascender": 0.9919999837875366, "descender": -0.3179999887943268, "text": "administration and ideas of governance that outlasted ", "origin": [82.013916015625, 391.136474609375], "bbox": [82.013916015625, 378.240478515625, 423.3679504394531, 395.2704772949219]}], "wmode": 0, "dir": [1.0, 0.0], "bbox": [82.013916015625, 378.240478515625, 423.3679504394531, 395.2704772949219]}, {"spans": [{"size": 13.0, "flags": 4, "bidi": 0, "char_flags": 16, "font": "BookmanOldStyle", "color": 2301728, "alpha": 255, "ascender": 0.9919999837875366, "descender": -0.3179999887943268, "text": "their rule, leaving a political legacy that succeeding ", "origin": [82.013916015625, 407.65948486328125], "bbox": [82.013916015625, 394.76348876953125, 423.2768859863281, 411.7934875488281]}], "wmode": 0, "dir": [1.0, 0.0], "bbox": [82.013916015625, 394.76348876953125, 423.2768859863281, 411.7934875488281]}, {"spans": [{"size": 13.0, "flags": 4, "bidi": 0, "char_flags": 16, "font": "BookmanOldStyle", "color": 2301728, "alpha": 255, "ascender": 0.9919999837875366, "descender": -0.3179999887943268, "text": "rulers of the subcontinent could not ignore. Today ", "origin": [82.013916015625, 424.1824951171875], "bbox": [82.013916015625, 411.2864990234375, 423.35491943359375, 428.3164978027344]}], "wmode": 0, "dir": [1.0, 0.0], "bbox": [82.013916015625, 411.2864990234375, 423.35491943359375, 428.3164978027344]}, {"spans": [{"size": 13.0, "flags": 4, "bidi": 0, "char_flags": 16, "font": "BookmanOldStyle", "color": 2301728, "alpha": 255, "ascender": 0.9919999837875366, "descender": -0.3179999887943268, "text": "the Prime Minister of India addresses the nation on ", "origin": [82.013916015625, 440.70550537109375], "bbox": [82.013916015625, 427.80950927734